{
  "manifest_version": 3,
  "name": "AI 同声传译助手浮层",
  "description": "在网页上显示可拖动的 AI 同声传译字幕浮层。",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
